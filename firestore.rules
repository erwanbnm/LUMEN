rules_version = '2';
// Règles de sécurité de Lumen (mode en ligne). À coller dans Firebase > Firestore > Règles.
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    match /users/{uid} {
      allow read: if signed();
      allow create, update: if signed() && request.auth.uid == uid;
    }
    match /pseudos/{p} {
      allow read: if true;
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
    }
    match /tokens/{uid} {
      allow read, write: if signed() && request.auth.uid == uid;
    }
    match /saves/{uid} {
      allow read, write: if signed() && request.auth.uid == uid;
    }
    match /duels/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.from == request.auth.uid;
      allow update: if signed()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to)
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.qids == resource.data.qids
        && request.resource.data.res.diff(resource.data.res).affectedKeys().hasOnly([request.auth.uid]);
    }
    // Boss de la semaine : un document par semaine, chacun ne modifie que ses propres dégâts, ses jours et ses appels
    match /bosses/{w} {
      allow read: if signed();
      allow create: if signed();
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["tot", "dmg", "days", "calls", "defeatedAt", "killer"])
        && (!("dmg" in resource.data) || request.resource.data.dmg.diff(resource.data.dmg).affectedKeys().hasOnly([request.auth.uid]))
        && (!("days" in resource.data) || request.resource.data.days.diff(resource.data.days).affectedKeys().hasOnly([request.auth.uid]))
        && (!("calls" in resource.data) || request.resource.data.calls.diff(resource.data.calls).affectedKeys().hasOnly([request.auth.uid]));
    }
    // Salons privés : l'hôte crée le salon ; un joueur peut s'ajouter lui-même ; les membres font avancer la partie
    match /rooms/{code} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.host == request.auth.uid;
      allow update: if signed() && (request.auth.uid in resource.data.players
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["players"])
            && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])));
      match /chat/{m} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.u == request.auth.uid;
      }
    }
    // Calendrier de connexion : l'heure vient du serveur (request.time). Une récupération par jour, numérotées 1, 2, 3…
    match /clock/{u} {
      allow read: if signed() && request.auth.uid == u;
      allow write: if signed() && request.auth.uid == u && request.resource.data.t == request.time;
    }
    match /logins/{u} {
      function today() { return int((request.time.toMillis() + 3600000) / 86400000); }
      allow read: if signed() && request.auth.uid == u;
      allow create: if signed() && request.auth.uid == u && request.resource.data.at == request.time
        && request.resource.data.day == today() && request.resource.data.n == 1;
      allow update: if signed() && request.auth.uid == u && request.resource.data.at == request.time
        && request.resource.data.day == today() && today() > resource.data.day && request.resource.data.n == resource.data.n + 1;
    }
    // Guildes : 5 membres maximum. Le chef gère tout, le bras droit accepte et invite, un membre invite et peut partir.
    match /guildNames/{n} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow delete: if signed() && (resource.data.uid == request.auth.uid || !exists(/databases/$(db)/documents/guilds/$(resource.data.g)));
    }
    match /guilds/{g} {
      function mem() { return request.auth.uid in resource.data.members; }
      function role() { return resource.data.members[request.auth.uid].role; }
      function keys() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function mdiff() { return request.resource.data.members.diff(resource.data.members); }
      function fixed() { return request.resource.data.name == resource.data.name && request.resource.data.nameL == resource.data.nameL && request.resource.data.created == resource.data.created; }
      allow read: if signed();
      allow create: if signed() && request.resource.data.leader == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid]) && request.resource.data.bonus == 0 && request.resource.data.done.size() == 0;
      allow delete: if signed() && mem() && role() == "chef" && resource.data.members.size() == 1;
      allow update: if signed() && request.resource.data.members.size() <= 5 && fixed() && (
        (mem() && role() == "chef")
        || (mem() && role() == "off" && keys().hasOnly(["members", "apps", "inv"]) && mdiff().changedKeys().size() == 0 && mdiff().removedKeys().size() == 0)
        || (mem() && keys().hasOnly(["inv"]))
        || (mem() && keys().hasOnly(["members"]) && mdiff().affectedKeys().hasOnly([request.auth.uid]) && mdiff().removedKeys().hasOnly([request.auth.uid]))
        || (mem() && keys().hasOnly(["done", "bonus"]) && request.resource.data.done.size() == resource.data.done.size() + 1
            && request.resource.data.bonus == resource.data.bonus + 500)
        || (!mem() && keys().hasOnly(["apps"]) && request.resource.data.apps.diff(resource.data.apps).affectedKeys().hasOnly([request.auth.uid]))
        || (!mem() && request.auth.uid in resource.data.inv && keys().hasOnly(["members", "inv"])
            && mdiff().addedKeys().hasOnly([request.auth.uid]) && mdiff().changedKeys().size() == 0 && mdiff().removedKeys().size() == 0
            && request.resource.data.members[request.auth.uid].role == "mem"));
      // Contributions : chacun n'écrit que la sienne, uniquement s'il est membre, et ses compteurs ne font que monter
      match /contrib/{u} {
        function was(k) { return resource == null ? 0 : resource.data.all[k]; }
        function up(k, max) { return request.resource.data.all[k] >= was(k) && request.resource.data.all[k] <= was(k) + max; }
        allow write: if signed() && request.auth.uid == u
          && request.auth.uid in get(/databases/$(db)/documents/guilds/$(g)).data.members
          && up("ok", 300) && up("mp", 20) && up("win", 20) && up("xp", 3000);
        allow delete: if signed() && request.auth.uid == u;
      }
    }
    match /{path=**}/contrib/{u} {
      allow read: if signed();
    }
  }
}
